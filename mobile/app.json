{
  "expo": {
    "name": "Mephisto Relay",
    "slug": "mephisto-relay-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios"
    ],
    "scheme": "mephistorelay",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mephistorelay.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSLocalNetworkUsageDescription": "Mephisto Relay connects to your analysis server on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "Allow Mephisto Relay to keep the current analysis connected.",
          "locationAlwaysAndWhenInUsePermission": "Allow Mephisto Relay to refresh the Dynamic Island while the app is in the background."
        }
      ],
      "./plugins/with-widget-chess-assets.cjs",
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "frequentUpdates": true,
          "bundleIdentifier": "com.mephistorelay.mobile.widgets",
          "groupIdentifier": "group.com.mephistorelay.mobile"
        }
      ]
    ],
    "extra": {
      "relayUrl": "http://127.0.0.1:8080"
    }
  }
}
